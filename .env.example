# Required: the key API clients send as "Authorization: Bearer ..."
API_KEY=

# --- judge (an LLM is required, runs fail without one) ---
# Any OpenAI-compatible API. Defaults: OpenRouter and its free model router.
LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openrouter/free
# Or a local command that reads the prompt on stdin (Node server only):
# LLM_COMMAND=claude -p
# Most judge calls per minute (default 20, 0 = no limit)
# LLM_REQUESTS_PER_MINUTE=20

# --- search (for search monitors) ---
# TAVILY_API_KEY=
# SEARXNG_URL=http://localhost:8080

# --- javascript-rendered pages (optional) ---
# BROWSER_WS_URL=ws://localhost:9222

# --- dashboard (off unless all three are set) ---
# DASHBOARD_USER=
# DASHBOARD_PASSWORD=
# SESSION_SECRET=

# --- telemetry (optional, any OTLP/HTTP backend) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20...
# OTEL_SERVICE_NAME=open-monitor

# --- misc ---
# PORT=8787
# DB_PATH=monitor.db
# ALLOW_PRIVATE_URLS=1
# TRUST_PROXY=1
